# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string
MONGODB_URI=

# Groq (AI answers)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Firebase Authentication (sign-in). From Firebase console > Project settings > General > Your apps > Web app.
# These are public web settings, not secrets. Leave FIREBASE_PROJECT_ID empty to run in local mode without sign-in.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Set to production on the live server. Production refuses to run without sign-in.
NODE_ENV=development

# Optional: request limits (defaults shown)
# RATE_LIMIT_API_PER_15_MIN=300   # all API calls, per network address
# RATE_LIMIT_AI_PER_MINUTE=20     # Rabbit / quiz AI calls, per signed-in person
# RATE_LIMIT_AI_PER_DAY=150       # Rabbit / quiz AI calls, per signed-in person

# Optional: other websites allowed to call this API from a browser (comma-separated).
# Not needed when the pages and the server share one address.
# ALLOWED_ORIGINS=https://example.com
